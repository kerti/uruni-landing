---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CaraKerja from '../components/CaraKerja.astro';
import Kenapa from '../components/Kenapa.astro';
import YangDicatat from '../components/YangDicatat.astro';
import Bukti from '../components/Bukti.astro';
import FokusUruni from '../components/FokusUruni.astro';
import ServerSendiri from '../components/ServerSendiri.astro';
import TanyaJawab from '../components/TanyaJawab.astro';
import Penutup from '../components/Penutup.astro';
import Footer from '../components/Footer.astro';
import Backdrop from '../components/Backdrop.astro';
import { META_DESCRIPTION, PAGE_TITLE } from '../data/copy';
---

<Base title={PAGE_TITLE} description={META_DESCRIPTION}>
  <Header />
  <main id="content">
    <Backdrop at="top">
      <Hero />
    </Backdrop>
    <CaraKerja />
    <Kenapa />
    <YangDicatat />
    <Bukti />
    <FokusUruni />
    <ServerSendiri />
    <TanyaJawab />
    <Backdrop at="bottom">
      <Penutup />
    </Backdrop>
  </main>
  <Footer />
</Base>
