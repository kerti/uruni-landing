---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CaraKerja from '../components/CaraKerja.astro';
import Kenapa from '../components/Kenapa.astro';
import YangBukan from '../components/YangBukan.astro';
import YangDicatat from '../components/YangDicatat.astro';
import Bukti from '../components/Bukti.astro';
import CatatanPendiri from '../components/CatatanPendiri.astro';
import ServerSendiri from '../components/ServerSendiri.astro';
---

<Base title="Uruni">
  <meta slot="head" name="robots" content="noindex" />
  <Header />
  <main id="content">
    <Hero />
    <CaraKerja />
    <Kenapa />
    <YangBukan />
    <YangDicatat />
    <Bukti />
    <CatatanPendiri />
    <ServerSendiri />
  </main>
</Base>
