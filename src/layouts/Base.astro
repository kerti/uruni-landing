---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import '../styles/global.css';
import Reveal from '../components/Reveal.astro';
// The Latin subset carries every word on the page; preloaded so the reveal
// script's wait for it (Reveal.astro) is short.
import fontLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

import { APP_REPO_URL, LICENSE_URL } from '../consts';
import { CANONICAL, HEADLINE, SHARE_DESCRIPTION } from '../data/copy';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Absolute URLs from `site` (astro.config.mjs), as Open Graph requires.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The share card: a still of the hero, made by scripts/og-image.mjs
// (npm run og) from the built page, so it can't drift from it.
// The image URL carries a hash of the file, so link-preview caches (Facebook,
// WhatsApp, Slack, opengraph.xyz) fetch a new card whenever it changes.
const ogVersion = createHash('sha256')
  .update(readFileSync('public/og.png'))
  .digest('hex')
  .slice(0, 8);
const og = {
  image: new URL(`/og.png?v=${ogVersion}`, Astro.site).href,
  width: 2400,
  height: 1260,
  alt: `Uruni. ${HEADLINE}. Uang tunai dan saldo bank yang dihitung, jumlahnya cocok dengan catatan.`,
};
// Structured data under the claims rule (CONTEXT.md section 6): only what the
// claims list allows.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Uruni',
  url: canonical,
  description: CANONICAL,
  image: og.image,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'id',
  isAccessibleForFree: true,
  license: LICENSE_URL,
  sameAs: [APP_REPO_URL],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <!-- Motion only with IntersectionObserver and no reduced-motion preference;
         dropped again if the reveal script hasn't reported in after 2.5 s. -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        if (
          'IntersectionObserver' in window &&
          window.matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          root.classList.add('motion');
          setTimeout(function () {
            if (!window.__revealReady) root.classList.remove('motion');
          }, 2500);
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Uruni" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SHARE_DESCRIPTION} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og.image} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={SHARE_DESCRIPTION} />
    <meta name="twitter:image" content={og.image} />
    <meta name="twitter:image:alt" content={og.alt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- --background, as hex (a meta can't read a custom property). -->
    <meta name="theme-color" content="#f3f3f2" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Reveal />
  </body>
</html>
