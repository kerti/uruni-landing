---
// Both calls to action and the caveat under them (CONTEXT.md section 8). One
// component, because the hero and the closing section must say them word for
// word.
import { DEMO_URL, SELF_HOSTING_URL } from '../consts';
---

<div class="ctas">
  <a class="btn primary" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
    {' '}
    Coba demo{' '}
  </a>
  <a class="btn secondary" href={SELF_HOSTING_URL} target="_blank" rel="noopener noreferrer">
    Panduan pemasangan <span class="lang">(bahasa Inggris)</span>
  </a>
</div>
<p class="caveat">
  Tanpa daftar. Datanya rekaan dan siapa pun bisa mengubahnya; demo kembali bersih paling lama
  setiap jam.
</p>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 0.375rem;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.75rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }
  .primary {
    background-color: var(--primary);
    color: var(--primary-foreground);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 1px 2px rgba(34, 50, 58, 0.12),
      0 2px 6px rgba(34, 50, 58, 0.08);
  }
  .primary:hover {
    background-color: var(--primary-hover);
  }
  .secondary {
    background-color: var(--secondary);
    color: var(--secondary-foreground);
  }
  .lang {
    font-weight: 400;
    font-size: 0.875rem;
  }
  @media (max-width: 29.99rem) {
    .btn {
      width: 100%;
    }
  }

  .caveat {
    margin-top: 0.875rem;
    max-width: 34rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
</style>
