---
// Catatan pendiri: a placeholder until the maintainer writes the note
// (CONTEXT.md section 10, item 8). Shown on purpose, so the gap is visible on
// every preview; the note must replace it before launch.
---

<section class="section" aria-labelledby="catatan-pendiri-title">
  <div class="container">
    <div class="note rise" data-reveal>
      <p class="eyebrow">Catatan pendiri</p>
      <h2 id="catatan-pendiri-title" class="sr-only">
        Catatan pendiri
      </h2>
      <p class="placeholder">Catatan dari pendiri Uruni&nbsp;menyusul.</p>
    </div>
  </div>
</section>

<style>
  .note {
    max-width: 40rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px dashed var(--input);
    border-radius: 1rem;
  }
  .placeholder {
    color: var(--muted-foreground);
    font-size: 1.125rem;
  }
</style>
