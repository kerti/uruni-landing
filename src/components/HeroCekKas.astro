---
// The hero illustration: a cek kas that is cocok.
//
// It opens as the vessel: the money in two places, as two account cards, each
// streaming into the brand's U, which pools contributions. Then the cards'
// icon, name and amount travel into the first two rows of the tally (what was
// counted, added up, beside what the records say, then the Cocok state) while
// the tally's card forms around them. It plays once on load, about 3.3 s, and
// rests on the tally.
//
// Pure CSS, no script. The tally is the resting state: without motion
// (prefers-reduced-motion) the vessel never shows and every piece is simply in
// its row, and every animation ends on the tally, so nothing is left hidden.
// Under 5 s and not looping, so WCAG 2.2.2 needs no pause control.
//
// The travel is a translate from where a piece sits on a card to where it sits
// in its row, so both places are fixed geometry: the vessel is 18rem wide and
// centred, the rows have fixed line heights, and the figure is a size
// container so its width (100cqi) is known. Change a row's padding, line
// height or font size and the offsets in the motion block must follow.
import Icon from './Icon.astro';
import { accounts, counted, recorded } from '../data/fund';
import { rupiah } from '../lib/format';

if (counted !== recorded) throw new Error('The hero shows a cek kas that is cocok');

const label = `Uang tunai ${rupiah(accounts.tunai.counted)} dan saldo bank ${rupiah(accounts.bank.counted)}, jumlahnya ${rupiah(counted)}, cocok dengan catatan ${rupiah(recorded)}.`;
---

<figure class="cekkas" role="img" aria-label={label} data-reveal>
  <!-- One viewBox unit is 1/16rem. The cards are 8rem by 7.25rem; the bank's
       sits one row (5.75rem) lower, so each card's pieces travel to their row
       in a band of their own and never cross the other card's. -->
  <div class="vessel" aria-hidden="true">
    <svg viewBox="0 0 288 320">
      <rect class="card-bg card-l" width="128" height="116" rx="16"></rect>
      <rect class="card-bg card-r" x="160" y="92" width="128" height="116" rx="16"></rect>

      <!-- Each stream is dotted; a solid copy in a mask draws it on. -->
      <mask id="cekkas-draw-l" maskUnits="userSpaceOnUse" x="0" y="0" width="288" height="320">
        <path class="draw draw-l" pathLength="1" d="M64 118 C 64 200, 120 214, 134 250"></path>
      </mask>
      <mask id="cekkas-draw-r" maskUnits="userSpaceOnUse" x="0" y="0" width="288" height="320">
        <path class="draw draw-r" pathLength="1" d="M224 210 C 224 236, 166 230, 154 250"></path>
      </mask>
      <path class="stream" mask="url(#cekkas-draw-l)" d="M64 118 C 64 200, 120 214, 134 250"></path>
      <path
        class="stream"
        mask="url(#cekkas-draw-r)"
        d="M224 210 C 224 236, 166 230, 154 250"
      ></path>

      <!-- The logomark's path, scaled. -->
      <g transform="translate(144 252) scale(2.6) translate(-32 -20)">
        <g class="mark">
          <path
            d="M21 18 L21 31 A11 11 0 0 0 43 31 L43 18"
            fill="none"
            stroke="var(--primary)"
            stroke-width="6"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <circle cx="32" cy="30" r="5" fill="var(--accent)"></circle>
        </g>
      </g>
    </svg>
  </div>

  <div class="tally" aria-hidden="true">
    <div class="card"></div>
    <div class="row acct acct-l">
      <span class="ico-chip">
        <Icon name="wallet" size={20} />
      </span>
      <span class="what">
        <span class="name">{accounts.tunai.name}</span>
        <small>dihitung</small>
      </span>
      <span class="amt">{rupiah(accounts.tunai.counted)}</span>
    </div>
    <div class="row acct acct-r">
      <span class="ico-chip">
        <Icon name="landmark" size={20} />
      </span>
      <span class="what">
        <span class="name">{accounts.bank.name}</span>
        <small>saldo di bank</small>
      </span>
      <span class="amt">{rupiah(accounts.bank.counted)}</span>
    </div>
    <div class="row sum" style="--i: 0">
      <span class="what">Uang yang ada</span>
      <span class="amt">{rupiah(counted)}</span>
    </div>
    <div class="row rec" style="--i: 1">
      <span class="what">Tercatat</span>
      <span class="amt">{rupiah(recorded)}</span>
    </div>
    <div class="state">
      <Icon name="check" size={18} /> Cocok
    </div>
  </div>
</figure>

<style>
  .cekkas {
    container-type: inline-size;
    display: grid;
    margin: 0;
    width: 100%;
    max-width: 26rem;
    justify-self: center;
    align-items: start;
  }
  /* Both drawings occupy the same cell, top-aligned. */
  .vessel,
  .tally {
    grid-area: 1 / 1;
  }

  /* --- The vessel --------------------------------------------------- */
  .vessel {
    display: none;
    width: 18rem;
    justify-self: center;
  }
  .vessel svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .card-bg {
    fill: var(--card);
    filter: drop-shadow(0 4px 12px rgba(34, 50, 58, 0.08));
  }
  .stream {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
  }
  .draw {
    fill: none;
    stroke: #fff;
    stroke-width: 8;
  }

  /* --- The tally (the resting state) -------------------------------- */
  .tally {
    position: relative;
    isolation: isolate;
    padding: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .card {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 1rem;
    background-color: var(--card);
    box-shadow: var(--shadow-card);
  }
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
  }
  .row + .row {
    border-top: 1px solid var(--border);
  }
  .ico-chip {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background-color: var(--secondary);
    color: var(--secondary-foreground);
  }
  .what {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-weight: 600;
    line-height: 1.5rem;
  }
  .what small {
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.25rem;
    color: var(--muted-foreground);
  }
  .tally .amt {
    font-weight: 600;
    line-height: 1.5rem;
    white-space: nowrap;
  }
  .sum,
  .rec {
    grid-template-columns: 1fr auto;
  }
  .row.sum {
    border-top: 2px solid var(--foreground);
  }
  .rec .what,
  .rec .amt {
    color: var(--muted-foreground);
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background-color: var(--success-soft);
    color: var(--success);
    font-weight: 600;
  }

  /* --- Motion: the cards become the tally's first two rows, once ----- */
  @media (prefers-reduced-motion: no-preference) {
    .cekkas {
      --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
      --travel: cubic-bezier(0.65, 0, 0.25, 1);
    }

    /* Where each card sits: its centre and top, and how far its row is
       below the first one (a row is 4.25rem, plus the 1px border). */
    .acct-l {
      --cx: calc(50cqi - 5rem);
      --top: 0rem;
      --dy: 0rem;
      --in: 0ms;
      --go: 1750ms;
    }
    .acct-r {
      --cx: calc(50cqi + 5rem);
      --top: 5.75rem;
      --dy: calc(4.25rem + 1px);
      --in: 450ms;
      --go: 1900ms;
    }

    /* On a card, a piece sits centred: the chip at 0.75rem below the card's
       top, the name at 3.75rem (13px), the amount at 5rem (15px, bold). In
       its row, the chip is at 1.5rem from the left and 2.375rem from the
       tally's top, the name at 4.75rem and 2.25rem, and the amount ends
       1.5rem from the right, at 2.875rem. The percentages centre a piece by
       its own width, scaled.

       Across and down are separate animations (translate and transform), so
       a piece can take an L-shaped path: the bank's chip clears the row
       before its name rises into it, and its amount rises only once the
       name has gone. */
    .acct .ico-chip {
      --fx: calc(var(--cx) - 2.75rem);
      --fy: calc(var(--top) - 1.625rem - var(--dy));
    }
    .acct .name {
      --fx: calc(var(--cx) - 4.75rem - 40.625%);
      --fy: calc(var(--top) + 1.5rem - var(--dy));
      --scale: 0.8125;
      --weight: 500;
      --color: var(--muted-foreground);
    }
    .acct .amt {
      --fx: calc(var(--cx) - 100cqi + 1.5rem + 53.125%);
      --fy: calc(var(--top) + 2.125rem - var(--dy));
      --scale: 0.9375;
      --weight: 700;
    }
    .acct .ico-chip,
    .acct .name,
    .acct .amt {
      --x-at: var(--go);
      --x-for: 600ms;
      --y-at: var(--go);
      --y-for: 600ms;
      transform-origin: 0 0;
      animation:
        piece-in 400ms var(--ease) var(--in) both,
        piece-across var(--x-for) var(--travel) var(--x-at) both,
        piece-down var(--y-for) var(--travel) var(--y-at) both;
    }
    .acct-l .ico-chip {
      --x-for: 450ms;
      --y-at: calc(var(--go) + 250ms);
      --y-for: 400ms;
    }
    .acct-r .name {
      --x-for: 500ms;
      --y-at: calc(var(--go) + 300ms);
      --y-for: 400ms;
    }
    .acct-r .amt {
      --x-at: calc(var(--go) + 100ms);
      --x-for: 400ms;
      --y-at: calc(var(--go) + 400ms);
      --y-for: 350ms;
    }
    .acct small {
      animation: fade-in 300ms ease-out calc(var(--go) + 650ms) both;
    }
    .acct-r {
      animation: border-in 300ms ease-out 2550ms both;
    }

    .vessel {
      display: block;
    }
    .card-bg,
    .mark {
      transform-box: fill-box;
      transform-origin: center;
    }
    .card-bg {
      animation:
        card-in 400ms var(--ease) both,
        fade-out 350ms ease-in 1750ms both;
    }
    .card-r {
      animation-delay: 450ms, 1900ms;
    }
    .draw {
      stroke-dasharray: 1 2;
      animation: stream-draw 500ms ease-in-out 300ms both;
    }
    .draw-r {
      animation-delay: 750ms;
    }
    .stream {
      animation:
        stream-flow 2200ms linear both,
        fade-out 300ms ease-in 1750ms both;
    }
    .mark {
      animation:
        mark-fill 500ms var(--ease) 1250ms both,
        fade-out 300ms ease-in 1750ms both;
    }

    .card {
      animation: tally-in 450ms var(--ease) 1850ms both;
    }
    .sum,
    .rec {
      animation: row-in 350ms var(--ease) both;
      animation-delay: calc(2700ms + var(--i) * 110ms);
    }
    .state {
      transform-origin: left center;
      animation: state-in 300ms var(--ease) 3000ms both;
    }

    @keyframes piece-in {
      from {
        opacity: 0;
      }
    }
    @keyframes piece-across {
      from {
        translate: var(--fx) 0;
      }
    }
    @keyframes piece-down {
      from {
        transform: translateY(var(--fy)) scale(var(--scale, 1));
        font-weight: var(--weight, 600);
        color: var(--color, inherit);
      }
    }
    @keyframes card-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
    @keyframes fade-out {
      to {
        opacity: 0;
      }
    }
    @keyframes border-in {
      from {
        border-top-color: transparent;
      }
    }
    @keyframes stream-draw {
      from {
        stroke-dashoffset: 1;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
    /* The dots move toward the vessel: the money flowing in. */
    @keyframes stream-flow {
      to {
        stroke-dashoffset: -77;
      }
    }
    @keyframes mark-fill {
      50% {
        transform: scale(1.06);
      }
    }
    @keyframes tally-in {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
    }
    @keyframes row-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
    }
    @keyframes state-in {
      from {
        opacity: 0;
        transform: scale(0.85);
      }
    }
  }
</style>
