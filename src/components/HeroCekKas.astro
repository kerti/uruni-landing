---
// The hero illustration: a cek kas that is cocok.
//
// Two drawings share one frame. The vessel (the money in two places flowing
// into the brand's U, which pools contributions) plays first and hands over to
// the tally (what was counted, added up, beside what the records say, then the
// Cocok state). It plays once on load, about 2.8 s, and rests on the tally.
//
// Pure CSS, no script. The tally is the resting state: without motion
// (prefers-reduced-motion) the vessel never shows and the tally is simply
// there, and every animation ends on the tally, so nothing is left hidden.
// Under 5 s and not looping, so WCAG 2.2.2 needs no pause control.
import Icon from './Icon.astro';
import { accounts, counted, recorded } from '../data/fund';
import { lucide } from '../icons';
import { rupiah } from '../lib/format';

if (counted !== recorded) throw new Error('The hero shows a cek kas that is cocok');

const label = `Uang tunai ${rupiah(accounts.tunai.counted)} dan saldo bank ${rupiah(accounts.bank.counted)}, jumlahnya ${rupiah(counted)}, cocok dengan catatan ${rupiah(recorded)}.`;
---

<figure class="cekkas" role="img" aria-label={label} data-reveal>
  <div class="vessel" aria-hidden="true">
    <svg viewBox="0 0 440 360">
      <path class="stream" d="M90 112 C 90 190, 170 170, 196 236"></path>
      <path class="stream" d="M350 112 C 350 190, 270 170, 244 236"></path>

      <g transform="translate(30 20)">
        <g class="tag tag-l">
          <rect class="tag-bg" width="120" height="92" rx="16"></rect>
          <g transform="translate(48 14)" class="ico">
            {lucide.wallet.map((d) => (
              <path d={d} />
            ))}
          </g>
          <text x="60" y="60" class="name">
            {accounts.tunai.name}
          </text>
          <text x="60" y="80" class="amt">
            {rupiah(accounts.tunai.counted)}
          </text>
        </g>
      </g>

      <g transform="translate(278 20)">
        <g class="tag tag-r">
          <rect class="tag-bg" width="132" height="92" rx="16"></rect>
          <g transform="translate(54 14)" class="ico">
            {lucide.landmark.map((d) => (
              <path d={d} />
            ))}
          </g>
          <text x="66" y="60" class="name">
            {accounts.bank.name}
          </text>
          <text x="66" y="80" class="amt">
            {rupiah(accounts.bank.counted)}
          </text>
        </g>
      </g>

      <!-- The logomark's path, scaled. -->
      <g transform="translate(220 270) scale(4.2) translate(-32 -28)">
        <g class="mark">
          <path
            d="M21 18 L21 31 A11 11 0 0 0 43 31 L43 18"
            fill="none"
            stroke="var(--primary)"
            stroke-width="6"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <circle cx="32" cy="30" r="5" fill="var(--accent)"></circle>
        </g>
      </g>
    </svg>
  </div>

  <div class="tally" aria-hidden="true">
    <div class="row" style="--i: 0">
      <span class="ico-chip">
        <Icon name="wallet" size={20} />
      </span>
      <span class="what">
        {accounts.tunai.name}
        <small>dihitung</small>
      </span>
      <span class="amt">{rupiah(accounts.tunai.counted)}</span>
    </div>
    <div class="row" style="--i: 1">
      <span class="ico-chip">
        <Icon name="landmark" size={20} />
      </span>
      <span class="what">
        {accounts.bank.name}
        <small>saldo di bank</small>
      </span>
      <span class="amt">{rupiah(accounts.bank.counted)}</span>
    </div>
    <div class="row sum" style="--i: 2">
      <span class="what">Uang yang ada</span>
      <span class="amt">{rupiah(counted)}</span>
    </div>
    <div class="row rec" style="--i: 3">
      <span class="what">Tercatat</span>
      <span class="amt">{rupiah(recorded)}</span>
    </div>
    <div class="state">
      <Icon name="check" size={18} /> Cocok
    </div>
  </div>
</figure>

<style>
  .cekkas {
    display: grid;
    margin: 0;
    width: 100%;
    max-width: 26rem;
    justify-self: center;
    align-items: center;
  }
  /* Both drawings occupy the same cell. */
  .vessel,
  .tally {
    grid-area: 1 / 1;
  }

  /* --- The vessel --------------------------------------------------- */
  .vessel {
    display: none;
  }
  .vessel svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  .stream {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
  }
  .tag-bg {
    fill: var(--card);
    filter: drop-shadow(0 4px 12px rgba(34, 50, 58, 0.08));
  }
  .ico {
    fill: none;
    stroke: var(--secondary-foreground);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .name,
  .vessel .amt {
    text-anchor: middle;
  }
  .name {
    fill: var(--muted-foreground);
    font-size: 13px;
    font-weight: 500;
  }
  .vessel .amt {
    fill: var(--foreground);
    font-size: 15px;
    font-weight: 700;
  }

  /* --- The tally (the resting state) -------------------------------- */
  .tally {
    padding: 1.5rem;
    border-radius: 1rem;
    background-color: var(--card);
    box-shadow: var(--shadow-card);
    font-variant-numeric: tabular-nums;
  }
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
  }
  .row + .row {
    border-top: 1px solid var(--border);
  }
  .ico-chip {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background-color: var(--secondary);
    color: var(--secondary-foreground);
  }
  .what {
    display: flex;
    flex-direction: column;
    font-weight: 600;
  }
  .what small {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--muted-foreground);
  }
  .tally .amt {
    font-weight: 600;
    white-space: nowrap;
  }
  .sum,
  .rec {
    grid-template-columns: 1fr auto;
  }
  .row.sum {
    border-top: 2px solid var(--foreground);
  }
  .rec .what,
  .rec .amt {
    color: var(--muted-foreground);
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background-color: var(--success-soft);
    color: var(--success);
    font-weight: 600;
  }

  /* --- Motion: the vessel hands over to the tally, once ------------- */
  @media (prefers-reduced-motion: no-preference) {
    .cekkas {
      --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .vessel {
      display: block;
      animation: vessel-out 400ms var(--ease) 1450ms both;
    }
    .tag,
    .mark {
      transform-box: fill-box;
      transform-origin: center;
    }
    .tag {
      animation: tag-in 400ms var(--ease) both;
    }
    .tag-r {
      animation-delay: 120ms;
    }
    .stream {
      animation:
        stream-in 300ms ease-out 350ms both,
        stream-flow 1400ms linear 350ms both;
    }
    .mark {
      animation: mark-fill 500ms var(--ease) 1000ms both;
    }

    .tally {
      animation: tally-in 400ms var(--ease) 1550ms both;
    }
    .row {
      animation: row-in 350ms var(--ease) both;
      animation-delay: calc(1600ms + var(--i) * 110ms);
    }
    .state {
      transform-origin: left center;
      animation: state-in 300ms var(--ease) 2200ms both;
    }

    @keyframes tag-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
    @keyframes stream-in {
      from {
        opacity: 0;
      }
    }
    /* The dots move toward the vessel: the money flowing in. */
    @keyframes stream-flow {
      to {
        stroke-dashoffset: -44;
      }
    }
    @keyframes mark-fill {
      50% {
        transform: scale(1.06);
      }
    }
    @keyframes vessel-out {
      to {
        opacity: 0;
        transform: scale(0.94);
        visibility: hidden;
      }
    }
    @keyframes tally-in {
      from {
        opacity: 0;
        transform: translateY(16px) scale(0.98);
      }
    }
    @keyframes row-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
    }
    @keyframes state-in {
      from {
        opacity: 0;
        transform: scale(0.85);
      }
    }
  }
</style>
