---
// Kenapa: why cek kas is the point, from the problem in the app's PRD (§2).
// Copy approved 2026-10-28. Beside it, a still cek kas showing the other
// outcome from the hero's: the cash is cocok, the bank has a selisih, drawn
// the way the app's Cek kas screen draws them.
import Icon from './Icon.astro';
import { accounts, selisihCheck } from '../data/fund';
import { rupiah } from '../lib/format';

const gap = selisihCheck.bank.recorded - selisihCheck.bank.counted;
if (gap <= 0 || selisihCheck.tunai.counted !== selisihCheck.tunai.recorded) {
  throw new Error('Kenapa shows the cash cocok and the bank short');
}

const label = `Cek kas: uang tunai yang dihitung ${rupiah(selisihCheck.tunai.counted)}, cocok dengan catatan. Saldo rekening ${rupiah(selisihCheck.bank.counted)}, catatan ${rupiah(selisihCheck.bank.recorded)}: ada selisih ${rupiah(gap)}.`;
---

<section id="cek-kas" class="section" aria-labelledby="cek-kas-title">
  <div class="container grid">
    <div>
      <div class="rise" data-reveal>
        <p class="eyebrow">Kenapa cek kas</p>
        <h2 id="cek-kas-title" class="section-title">
          Yang paling repot bukan menagih iuran, tetapi mencocokkan catatan dengan uangnya.
        </h2>
      </div>
      <div class="body rise" data-reveal>
        <p>
          Di kelompok kecil, iuran biasanya lancar: semua membayar setelah gajian, dan pengingat
          cukup disampaikan langsung. Yang bikin pusing, uangnya ada di dua tempat: sebagian tunai
          di dompet, sebagian di rekening, kadang rekening pribadi bendahara sendiri.
        </p>
        <p>
          Lalu ada yang mengambil uang tunai untuk belanja dan lupa mencatatnya, atau kas rutin
          tercampur dengan uang sumbangan. Angkanya pelan-pelan bergeser, dan selisihnya baru
          ketahuan saat harus dicari.
        </p>
        <p>
          Uruni mencatat saldo per lokasi, jadi saat kamu menghitung tunai dan melihat saldo
          rekening, kelihatan di lokasi mana selisihnya. Cek kas sesering yang kamu mau; setiap
          hasilnya tersimpan, jadi selisih kecil ketahuan sebelum menumpuk.
        </p>
      </div>
    </div>

    <div data-reveal>
      <figure class="cek rise" role="img" aria-label={label} style="--delay: 100ms">
        <div class="loc" aria-hidden="true">
          <div class="head">
            <span class="name">{accounts.tunai.name}</span>
            <span class="rec">
              Menurut catatan <b>{rupiah(selisihCheck.tunai.recorded)}</b>
            </span>
          </div>
          <div class="count">
            <span class="what">Dihitung</span>
            <span class="amt">{rupiah(selisihCheck.tunai.counted)}</span>
          </div>
          <p class="status ok">
            <Icon name="circleCheck" size={20} /> Cocok
          </p>
        </div>
        <div class="loc" aria-hidden="true">
          <div class="head">
            <span class="name">{accounts.bank.name}</span>
            <span class="rec">
              Menurut catatan <b>{rupiah(selisihCheck.bank.recorded)}</b>
            </span>
          </div>
          <div class="count">
            <span class="what">Saldo di bank</span>
            <span class="amt">{rupiah(selisihCheck.bank.counted)}</span>
          </div>
          <p class="status gap">
            <Icon name="triangleAlert" size={20} />
            <span>
              Ada selisih <span class="nowrap">{rupiah(gap)}</span>
              <small>Mau dicek bareng?</small>
            </span>
          </p>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .body {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-top: 1.5rem;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }

  /* The app's Cek kas screen, still: one block per location. */
  .cek {
    display: grid;
    gap: 1rem;
    width: 100%;
    max-width: 26rem;
    margin: 0;
    justify-self: center;
    font-variant-numeric: tabular-nums;
  }
  .loc {
    container-type: inline-size;
    overflow: hidden;
    border-radius: 1rem;
    background-color: var(--card);
    box-shadow: var(--shadow-card);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--muted);
  }
  /* Narrow, both heads stack, rather than only the one whose name is long. */
  @container (max-width: 22rem) {
    .head {
      flex-direction: column;
    }
  }
  .name {
    font-weight: 600;
  }
  .rec {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .rec b {
    color: var(--foreground);
    font-weight: 600;
  }
  .count {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0;
  }
  .what {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .amt {
    font-size: 1.25rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .status {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.75rem 1rem 1rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    font-weight: 600;
  }
  .status :global(svg) {
    flex: none;
  }
  .ok {
    background-color: var(--success-soft);
    color: var(--success);
  }
  .gap {
    background-color: var(--attention-soft);
    color: var(--attention-text);
  }
  .gap small {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
