---
import { APP_REPO_URL } from '../consts';
import { simpleIcons } from '../icons';

// Section anchors join this list as their sections land, so the nav never
// points at a section that isn't on the page.
const sections: { id: string; label: string }[] = [];
---

<a class="skip-link" href="#content">
  Langsung ke konten
</a>
<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="#" aria-label="Uruni, kembali ke atas">
      <img src="/brand/uruni-lockup-horizontal.svg" alt="" width="184" height="64" />
    </a>
    {sections.length > 0 && (
      <nav aria-label="Bagian halaman">
        <ul>
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <a
      class="repo"
      href={APP_REPO_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Kode sumber Uruni di GitHub"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d={simpleIcons.github}></path>
      </svg>
    </a>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    background-color: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background-color: var(--background);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  /* The lockup's viewBox carries the mark's clear space; trim it visually so
     the mark lines up with the content edge. */
  .wordmark {
    display: block;
    margin-left: -0.75rem;
    border-radius: 0.5rem;
  }
  .wordmark img {
    display: block;
    height: 2.75rem;
    width: auto;
  }
  @media (min-width: 64rem) {
    .wordmark {
      margin-left: -0.875rem;
    }
    .wordmark img {
      height: 3.125rem;
    }
  }

  nav {
    display: none;
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }
  nav a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--primary);
  }
  @media (min-width: 64rem) {
    nav {
      display: block;
    }
  }

  .repo {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    margin-right: -0.5rem;
    border-radius: 999px;
    color: var(--foreground);
  }
  nav + .repo {
    margin-left: 0;
  }
  @media (max-width: 63.99rem) {
    nav + .repo {
      margin-left: auto;
    }
  }
  .repo:hover {
    color: var(--primary);
    background-color: var(--muted);
  }
</style>
