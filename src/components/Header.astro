---
import { APP_REPO_URL } from '../consts';
import { simpleIcons } from '../icons';

// Section anchors join this list as their sections land, so the nav never
// points at a section that isn't on the page.
const sections: { id: string; label: string }[] = [
  { id: 'cara-kerja', label: 'Cara kerja' },
  { id: 'cek-kas', label: 'Cek kas' },
  { id: 'laporan', label: 'Laporan' },
  { id: 'server-sendiri', label: 'Server sendiri' },
];
---

<a class="skip-link" href="#content">
  Langsung ke konten
</a>
<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="#" aria-label="Uruni, kembali ke atas">
      <img src="/brand/uruni-lockup-horizontal.svg" alt="" width="184" height="64" />
    </a>
    {sections.length > 0 && (
      <nav aria-label="Bagian halaman">
        <ul>
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <a
      class="repo"
      href={APP_REPO_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Kode sumber Uruni di GitHub"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d={simpleIcons.github}></path>
      </svg>
    </a>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    background-color: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }

  /* The app's header glass (web/src/index.css, header-glass, as of app commit
     5ee9fd4): the page's cream at 60% over a blurred, slightly saturated
     backdrop, so content scrolling beneath tints the bar instead of vanishing,
     a bright 1px rim just inside the hairline, and a soft lift downward. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--background) 60%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    box-shadow:
      inset 0 -1px 0 rgb(255 255 255 / 0.85),
      inset 0 -10px 14px -10px rgb(255 255 255 / 0.7),
      0 4px 16px rgb(34 50 58 / 0.08);
  }
  /* Without a backdrop filter, 60% cream would let the page show through
     unblurred: stay solid. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background-color: var(--background);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  /* The lockup's viewBox carries the mark's clear space; trim it visually so
     the mark lines up with the content edge. */
  .wordmark {
    display: block;
    margin-left: -0.75rem;
    border-radius: 0.5rem;
  }
  .wordmark img {
    display: block;
    height: 2.75rem;
    width: auto;
  }
  @media (min-width: 64rem) {
    .wordmark {
      margin-left: -0.875rem;
    }
    .wordmark img {
      height: 3.125rem;
    }
  }

  nav {
    display: none;
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }
  nav a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--primary);
  }
  @media (min-width: 64rem) {
    nav {
      display: block;
    }
  }

  .repo {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    margin-right: -0.5rem;
    border-radius: 999px;
    color: var(--foreground);
  }
  nav + .repo {
    margin-left: 0;
  }
  @media (max-width: 63.99rem) {
    nav + .repo {
      margin-left: auto;
    }
  }
  .repo:hover {
    color: var(--primary);
    background-color: var(--muted);
  }
</style>
