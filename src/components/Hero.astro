---
// Copy from CONTEXT.md sections 5 and 8 (approved 2026-10-28). The buttons and
// caveat are Ctas, which the closing section repeats word for word.
import Ctas from './Ctas.astro';
import HeroCekKas from './HeroCekKas.astro';

const chips = ['Gratis selamanya', 'Sumber terbuka', 'Di server sendiri', 'Berbahasa Indonesia'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">Untuk bendahara kas kelompok kecil</p>
      <h1 id="hero-title">
        Catatan kas yang <span class="accent">selalu cocok</span> dengan uang yang ada.
      </h1>
      <p class="lede">
        Catat uang masuk dan keluar dari ponsel. Saat cek kas, kamu menghitung uang tunai dan
        melihat saldo rekening; Uruni membandingkannya dengan catatan dan menunjukkan selisihnya
        kalau ada.
      </p>
      <Ctas />
      <ul class="chips">
        {chips.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    </div>
    <HeroCekKas />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem) var(--section-pad);
  }
  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .accent {
    color: var(--primary);
  }

  .lede {
    margin-top: 1.25rem;
    max-width: 34rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
  }

  .chips {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 26rem;
  }
  @media (min-width: 23rem) {
    .chips {
      grid-template-columns: 1fr 1fr;
    }
  }
  .chips li {
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background-color: var(--muted);
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: center;
  }
</style>
