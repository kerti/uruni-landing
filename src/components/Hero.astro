---
// Copy from CONTEXT.md sections 5 and 8 (approved 2026-10-28). The CTA block is
// repeated word for word by the closing section.
import { DEMO_URL, SELF_HOSTING_URL } from '../consts';
import HeroCekKas from './HeroCekKas.astro';

const chips = ['Gratis selamanya', 'Sumber terbuka', 'Di server sendiri', 'Berbahasa Indonesia'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">
        <span class="dot" aria-hidden="true"></span>Untuk bendahara kas kelompok kecil
      </p>
      <h1 id="hero-title">
        Catatan kas yang <span class="accent">selalu cocok</span> dengan uang yang ada.
      </h1>
      <p class="lede">
        Catat uang masuk dan keluar dari ponsel. Saat cek kas, kamu menghitung uang tunai dan
        melihat saldo rekening; Uruni membandingkannya dengan catatan dan menunjukkan selisihnya
        kalau ada.
      </p>
      <div class="ctas">
        <a class="btn primary" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
          Coba demo
        </a>
        <a class="btn secondary" href={SELF_HOSTING_URL} target="_blank" rel="noopener noreferrer">
          Panduan pemasangan <span class="lang">(bahasa Inggris)</span>
        </a>
      </div>
      <p class="caveat">
        Tanpa daftar. Datanya rekaan dan siapa pun bisa mengubahnya; demo kembali bersih paling lama
        setiap jam.
      </p>
      <ul class="chips">
        {chips.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    </div>
    <HeroCekKas />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem) var(--section-pad);
  }
  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--primary);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background-color: var(--accent);
  }

  h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .accent {
    color: var(--primary);
  }

  .lede {
    margin-top: 1.25rem;
    max-width: 34rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .primary {
    background-color: var(--primary);
    color: var(--primary-foreground);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 1px 2px rgba(34, 50, 58, 0.12),
      0 2px 6px rgba(34, 50, 58, 0.08);
  }
  .primary:hover {
    background-color: var(--primary-hover);
  }
  .secondary {
    background-color: var(--secondary);
    color: var(--secondary-foreground);
  }
  .lang {
    font-weight: 400;
    font-size: 0.875rem;
  }
  @media (max-width: 29.99rem) {
    .btn {
      width: 100%;
    }
  }

  .caveat {
    margin-top: 0.875rem;
    max-width: 34rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .chips {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 26rem;
  }
  @media (min-width: 23rem) {
    .chips {
      grid-template-columns: 1fr 1fr;
    }
  }
  .chips li {
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background-color: var(--muted);
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: center;
  }
</style>
