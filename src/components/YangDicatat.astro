---
// Yang dicatat: the four shapes a small group's money takes besides plain in
// and out. Copy approved 2026-10-28, lede added 2026-11-05; each card is on
// CONTEXT.md's claims list (dues by golongan with who hasn't paid, amplop and
// its leftover, talangan with an optional receipt, titipan). Only amplop and
// titipan are kept apart from Kas Utama; the lede says no more than that.
// Never a group's private names as examples (CONTEXT.md section 1).
import IconCards from './IconCards.astro';

const cards = [
  {
    icon: 'users',
    title: 'Iuran per golongan',
    body: 'Besar iuran bisa berbeda per golongan anggota, dan Uruni menunjukkan siapa yang belum\u00a0membayar.',
  },
  {
    icon: 'envelope',
    title: 'Amplop',
    body: 'Untuk acara seperti jenguk atau kelahiran, sumbangan dan pengeluarannya dicatat di amplop sendiri. Sisanya masuk ke Kas Utama saat amplop ditutup.',
  },
  {
    icon: 'receipt',
    title: 'Talangan',
    body: 'Anggota yang memakai uangnya sendiri lebih dulu tetap tercatat, dengan foto nota kalau ada, sampai diganti dari kas.',
  },
  {
    icon: 'arrowsLeftRight',
    title: 'Titipan',
    body: 'Uang yang dikumpulkan untuk diteruskan ke pihak lain dicatat terpisah, karena bukan milik kas ini.',
  },
] as const;
---

<section class="section" aria-labelledby="yang-dicatat-title">
  <div class="container">
    <div class="rise" data-reveal>
      <p class="eyebrow">Yang dicatat</p>
      <h2 id="yang-dicatat-title" class="section-title">
        Kas kelompok jarang sesederhana masuk dan keluar.
      </h2>
      <p class="intro">
        Setiap jenis dicatat dengan caranya sendiri, jadi uang untuk acara atau titipan tidak
        tercampur dengan Kas Utama.
      </p>
    </div>

    <div class="rise" data-reveal style="--delay: 100ms">
      <IconCards cards={cards} />
    </div>
  </div>
</section>

<style>
  .intro {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }
</style>
