#!/bin/sh
# Pre-commit secret guard.
#
# Runs `gitleaks protect --staged` on the staged diff so a secret is caught
# before it reaches even a local commit. --redact keeps any matched value out of
# the terminal and out of an agent's context. Without gitleaks installed this
# skips with a note; the CI gitleaks job (full history) is the hard gate.
#
# Enabled per clone by scripts/hooks-install.sh (core.hooksPath).
# Policy: never bypass with `git commit --no-verify`.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed - skipping local scan (CI still enforces)." >&2
  echo "  install: brew install gitleaks" >&2
  exit 0
fi

if ! gitleaks protect --staged --redact --config .gitleaks.toml; then
  echo "x gitleaks: a staged change looks like a secret - commit blocked." >&2
  echo "  Remove the secret and re-stage. Do NOT use --no-verify." >&2
  exit 1
fi
exit 0
